# Secret của edge function — CHỈ tên biến, không giá trị thật.
# Local: chép thành supabase/functions/.env (gitignored) cho `supabase functions serve`.
# Production: `supabase secrets set KEY=value` (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY Supabase tự cấp).

# --- Legacy single-tenant (Shortcut cũ, gỡ ở phase 4) ---
SHORTCUT_SECRET=
DEFAULT_USER_ID=
OWNER_NAMES=

# --- Thanh toán (_shared/payment-config.ts). Thiếu bộ nào -> ví đó ẩn, create-payment 503 provider_disabled ---
# sandbox | production. production từ chối key sandbox công khai.
PAYMENT_ENV=sandbox
# Trang web nhận user quay về sau thanh toán (production phải https), vd https://<app>.vercel.app/payment/return
PAYMENT_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# --- Đối soát (payment-reconcile). PHẢI khớp Vault secret `payment_reconcile_secret` ---
RECONCILE_SECRET=
