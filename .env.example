# Frontend environment variables
# Copy this file to .env.local and fill in values for development

# Supabase — lấy từ Supabase Dashboard > Project Settings > API
# (hoặc `supabase status` khi chạy local)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Thông tin pháp lý hiện trên /privacy và /terms. Để trống khi dev (hiện marker "[chưa điền]").
# Build production trên Vercel (VERCEL_ENV=production) FAIL nếu một trong ba biến còn trống.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_CONTACT_EMAIL=
VITE_DATA_REGION=

# Cloudflare Turnstile — site key CÔNG KHAI (secret key đặt ở Supabase Auth, không ở đây). Trống = không captcha.
# Chỉ đặt khi Supabase Auth đã bật captcha Turnstile với cùng widget. Key test luôn qua của Cloudflare: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
